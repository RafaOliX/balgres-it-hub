:80 {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        # SAMEORIGIN (antes DENY): la app incrusta /drawio/ en un iframe del mismo sitio
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # draw.io autoalojado (editor de diagramas de Notas)
    handle_path /drawio/* {
        reverse_proxy drawio:8080
    }

    # APK de Android (para descargas)
    handle_path /apk/* {
        root * /srv/apk
        file_server
        header Content-Type "application/vnd.android.package-archive"
    }

    # Imágenes
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
    }

    # Flutter Web
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
