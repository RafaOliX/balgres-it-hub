# setup-server.sh genera .env.prod con valores reales; esto es solo referencia.
COMPOSE_PROJECT_NAME=balgres-it-hub   # nombre de la instancia (separa contenedores y volúmenes)
HUB_PORT=8091                         # puerto en el que se abre la app
DB_USER=inventario
DB_PASSWORD=CAMBIA_ESTO
DB_NAME=inventario_it
JWT_SECRET=CAMBIA_ESTO
REDES_PING_MINUTES=5                  # 0 = no escanear la red (recomendado en pruebas)
# ADMIN_PASSWORD=                     # opcional; vacío = temporal que se imprime al instalar
